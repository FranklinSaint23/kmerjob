# =============================================================================
# KmerJob — variables d'environnement
# Copier en .env.local puis remplir. .env.local est gitignoré.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️  SERVEUR UNIQUEMENT — contourne toutes les policies RLS.
# Ne jamais préfixer NEXT_PUBLIC_, ne jamais importer dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq ---------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
# Modèle de travail. Voir https://console.groq.com/docs/models pour la liste à
# jour — les identifiants changent, un modèle retiré renvoie une 404.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Application --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Dohone (Mobile Money) ----------------------------------------------------
# Fournis après inscription marchand sur my-dohone.com.
# Tant qu'ils sont vides, le paiement tourne en mode simulation (voir
# lib/payment/dohone.ts) : les transactions sont bien écrites en base, mais
# aucun appel réseau réel n'est fait.
DOHONE_MERCHANT_KEY=
DOHONE_HASH_CODE=
DOHONE_API_URL=
# Secret partagé pour vérifier l'authenticité des callbacks Dohone.
DOHONE_WEBHOOK_SECRET=

# --- Scraper ------------------------------------------------------------------
# Jeton attendu par /api/scraper/ingest pour autoriser une ingestion.
# Générer avec : openssl rand -hex 32
SCRAPER_INGEST_TOKEN=
